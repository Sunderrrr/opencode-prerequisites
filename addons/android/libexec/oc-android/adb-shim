#!/usr/bin/env bash
# Faux « adb » installé dans ~/.local/share/oc-android/sdk/platform-tools/adb : redirige chaque appel vers l'adb du conteneur
# émulateur (oc-android-emu). mobile-mcp l'utilise via ANDROID_HOME, sans SDK installé sur la machine.
set -u
EMU="${OC_ANDROID_EMU:-oc-android-emu}"
PODMAN="${OC_PODMAN:-podman}"
MOUNTS="${XDG_DATA_HOME:-$HOME/.local/share}/oc-android/mounts"

# Le répertoire courant n'est utilisable dans le conteneur que s'il y a été monté (liste écrite par « emulator start »)
in_mounts() {
  local m
  [ -f "$MOUNTS" ] || return 1
  while IFS= read -r m; do
    [ -n "$m" ] || continue
    case "$PWD/" in "$m"/*) return 0 ;; esac
  done < "$MOUNTS"
  return 1
}

args=(exec -i)
if [ -t 0 ] && [ -t 1 ]; then args+=(-t); fi
if in_mounts; then args+=(-w "$PWD"); fi

"$PODMAN" "${args[@]}" "$EMU" adb "$@"
rc=$?
if [ "$rc" -eq 125 ]; then
  echo "oc-android : conteneur « $EMU » introuvable ou arrêté. Démarre l'émulateur : oc-android emulator start" >&2
fi
exit "$rc"
