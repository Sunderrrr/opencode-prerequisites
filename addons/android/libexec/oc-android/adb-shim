#!/usr/bin/env bash
# Fake "adb" installed at ~/.local/share/oc-android/sdk/platform-tools/adb: forwards every call to the adb of the
# emulator container (oc-android-emu). mobile-mcp uses it through ANDROID_HOME, with no SDK installed on the machine.
set -u
EMU="${OC_ANDROID_EMU:-oc-android-emu}"
PODMAN="${OC_PODMAN:-podman}"
MOUNTS="${XDG_DATA_HOME:-$HOME/.local/share}/oc-android/mounts"

# The current directory is usable in the container only if it was mounted there (list written by "emulator start")
in_mounts() {
  local m
  [ -f "$MOUNTS" ] || return 1
  while IFS= read -r m; do
    [ -n "$m" ] || continue
    case "$PWD/" in "$m"/*) return 0 ;; esac
  done < "$MOUNTS"
  return 1
}

args=(exec -i)
if [ -t 0 ] && [ -t 1 ]; then args+=(-t); fi
if in_mounts; then args+=(-w "$PWD"); fi

"$PODMAN" "${args[@]}" "$EMU" adb "$@"
rc=$?
if [ "$rc" -eq 125 ]; then
  echo "oc-android: container $EMU not found or stopped. Start the emulator: oc-android emulator start" >&2
fi
exit "$rc"
