{
  "$schema": "https://opencode.ai/config.json",

  // Modèles OpenCode Go (vérifie les IDs avec /models : la liste change souvent).
  // Tout tourne sur DeepSeek V4.1 Flash (gros quota : ~216 000 requêtes/mois).
  // Les agents n'ont pas de modèle propre : ils héritent de celui-ci. Pour en changer un,
  // ajoute `model: opencode-go/<id>` dans son fichier agents/<nom>.md.
  "model": "opencode-go/deepseek-v4.1-flash",
  "small_model": "opencode-go/deepseek-v4.1-flash",

  "autoupdate": "notify",

  // Le CEO est l'agent par défaut : il délègue aux spécialistes (agents/*.md)
  "default_agent": "ceo",
  "subagent_depth": 1, // les spécialistes ne lancent pas d'autres sous-agents

  // Compactage natif : buffer "10%" = on compacte quand il reste 10 % de contexte, soit à 90 % d'utilisation.
  "compaction": { "auto": true, "buffer": "10%" },

  // Équivalent du hook de formatage auto de Boris : formate après chaque édition
  "formatter": true,

  // Mémoire persistante entre sessions (nécessite `pip install mempalace`, fait par install.sh)
  // OpenCode v2 : clé "plugins" ("plugin" est marquée obsolète dans le schéma officiel).
  "plugins": ["@rvboris/opencode-mempalace"],

  // Mode débridé : tout est autorisé sans demande. Seules les catastrophes évidentes
  // (rm -rf /, secrets, push --force...) restent bloquées par plugins/guard.js.
  "permission": {
    "edit": "allow",
    "bash": { "*": "allow", "rm -rf /*": "deny", "rm -rf ~*": "deny" },
    "webfetch": "allow",
    "websearch": "allow", // recherche web intégrée (Exa/Parallel), sans clé avec le provider OpenCode Go
    "skill": { "*": "allow" },
    "task": { "*": "allow" }
  },

  // MCP : peu de serveurs, chacun consomme du contexte
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": { "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}" },
      "oauth": false,
      "enabled": true
    },
    // Navigateur piloté par l'IA (outil Microsoft). Installé et activé par install.sh (désactive-le si le contexte devient trop lourd).
    "playwright": {
      "type": "local",
      // Lanceur du kit : utilise Chromium/Chrome du système s'il existe, sinon celui de Playwright
      "command": ["{env:HOME}/.local/bin/oc-playwright-mcp"],
      "enabled": true
    },
    // --- DevOps (lecture seule / sans écriture) ---
    // Documentation du Terraform Registry (providers/modules). Pas de TFE_TOKEN : aucune action sur HCP Terraform.
    // Nécessite Docker ou Podman.
    "terraform": {
      "type": "local",
      "command": ["{env:HOME}/.local/bin/oc-terraform-mcp"], // Docker ou Podman, registre seulement
      "enabled": true
    },
    // Kubernetes en LECTURE SEULE (voir k8s-mcp.toml : read_only + Secrets bloqués). Utilise ton kubeconfig.
    // Vérifie le flag avec : npx kubernetes-mcp-server@latest --help
    "kubernetes": {
      "type": "local",
      "command": ["npx", "-y", "kubernetes-mcp-server@latest", "--config", "{env:HOME}/.config/opencode/k8s-mcp.toml"],
      "enabled": true
    },
    // Scan de vulnérabilités / misconfigurations / secrets (images, IaC, code). Nécessite `trivy` + plugin mcp (install.sh).
    "trivy": {
      "type": "local",
      "command": ["trivy", "mcp"],
      "enabled": true
    },
    // --- Internet / GitHub ---
    // Recherche de code dans des millions de dépôts GitHub publics (Vercel). Pas de compte.
    "grep_app": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "oauth": false,
      "enabled": true
    },

    // Navigateur headless léger en Rust (binaire `obscura` à installer, voir README).
    // Pas de --stealth par défaut ; ajoute-le seulement si tu en as besoin.
    "obscura": {
      "type": "local",
      "command": ["obscura", "mcp"],
      "enabled": true
    }
  }
}
