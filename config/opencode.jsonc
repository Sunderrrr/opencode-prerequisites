{
  "$schema": "https://opencode.ai/config.json",

  // Modèles OpenCode Go (vérifie les IDs avec /models : la liste change souvent)
  "model": "opencode-go/kimi-k2.7-code",      // build : gros quota mensuel
  "small_model": "opencode-go/glm-5.3-flash", // titres, résumés : quasi gratuit en quota

  "autoupdate": "notify",

  // Le CEO est l'agent par défaut : il délègue aux spécialistes (agents/*.md)
  "default_agent": "ceo",
  "subagent_depth": 1, // les spécialistes ne lancent pas d'autres sous-agents

  // Compactage : auto = filet de sécurité natif ; prune = retire les vieilles sorties d'outils.
  // Le déclenchement à 90 % est fait par plugins/auto-compact.js.
  "compaction": { "auto": true, "prune": true },

  // Équivalent du hook de formatage auto de Boris : formate après chaque édition
  "formatter": true,

  // Les agents natifs : Plan raisonne, Explore est un sous-agent rapide
  "agent": {
    "plan": { "model": "opencode-go/glm-5.2" },
    "explore": { "model": "opencode-go/mimo-v2.6-flash" }
  },

  // Mémoire persistante entre sessions (nécessite `pip install mempalace`, fait par install.sh)
  // Note : la doc du plugin écrit "plugins" (OpenCode v2) ; si rien ne se charge, renomme la clé.
  "plugin": ["@rvboris/opencode-mempalace"],

  // Sécurité : demander avant d'écrire/exécuter, autoriser les commandes lecture seule
  "permission": {
    "edit": "ask",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "ls*": "allow",
      "cat *": "allow",
      "rm -rf*": "deny"
    },
    "skill": { "*": "allow" }
  },

  // MCP : peu de serveurs, chacun consomme du contexte
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": { "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}" },
      "oauth": false,
      "enabled": true
    },
    // Navigateur piloté par l'IA (outil Microsoft). Installé et activé par install.sh (désactive-le si le contexte devient trop lourd).
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"],
      "enabled": true
    },
    // Navigateur headless léger en Rust (binaire `obscura` à installer, voir README).
    // Pas de --stealth par défaut ; ajoute-le seulement si tu en as besoin.
    "obscura": {
      "type": "local",
      "command": ["obscura", "mcp"],
      "enabled": true
    }
  }
}
