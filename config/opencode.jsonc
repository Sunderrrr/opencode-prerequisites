{
  "$schema": "https://opencode.ai/config.json",

  // OpenCode Go models (check the IDs with /models: the list changes often).
  // Everything runs on DeepSeek V4.1 Flash (large quota: ~216,000 requests/month).
  // Agents have no model of their own: they inherit this one. To change one,
  // add `model: opencode-go/<id>` to its agents/<name>.md file.
  "model": "opencode-go/deepseek-v4.1-flash",
  "small_model": "opencode-go/deepseek-v4.1-flash",

  "autoupdate": "notify",

  // The CEO is the default agent: it delegates to specialists (agents/*.md)
  "default_agent": "ceo",
  // Specialists do not spawn other subagents (depth 1 = v2 default). The top-level
  // "subagent_depth" key is ignored in v2: set it under "experimental".
  "experimental": { "subagent_depth": 1 },

  // Native compaction: buffer "10%" = compact when 10% of the context is left, i.e. at 90% usage.
  "compaction": { "auto": true, "buffer": "10%" },

  // Equivalent of Boris's auto-format hook: formats after every edit
  "formatter": true,

  // Persistent memory (MemPalace): local plugin plugins/mempalace/ generated by install.sh.
  // We do not use "plugins": ["@rvboris/opencode-mempalace"]: OpenCode fails to install that package
  // (peerDependencies conflict @opentui/core ^0.5 vs 0.8, ERESOLVE error on the npm side).

  // Unrestricted mode: everything is allowed without asking. Only obvious disasters
  // (rm -rf /, secrets, push --force...) are still blocked by plugins/guard/.
  "permission": {
    "edit": "allow",
    "bash": { "*": "allow", "rm -rf /*": "deny", "rm -rf ~*": "deny" },
    "webfetch": "allow",
    "websearch": "allow", // built-in web search (Exa/Parallel), no key needed with the OpenCode Go provider
    "skill": { "*": "allow" },
    // The ~229 tools of the rea MCP are visible only to the reverse-engineer agent (which allows them in its file):
    // exposing them to every agent would weigh down each session.
    "rea_*": "deny",
    // Same for the ~34 tools of the mobile MCP (Android module: android and mobile-tester agents only).
    "mobile_*": "deny",
    // Same for the semgrep MCP (SAST): reserved for the pentest and security agents.
    "semgrep_*": "deny",
    // Same for the chrome-devtools MCP: tools denied globally, granted per agent when needed
    // (add  "chrome-devtools_*": "allow"  to that agent's permission block).
    "chrome-devtools_*": "deny",
    "task": { "*": "allow" }
  },

  // MCP: few servers, each one consumes context.
  // OpenCode v2 schema: servers live under "servers" (the flat form is obsolete and 2.x does not read it).
  // To turn one off: add  "disabled": true  to its block.
  "mcp": {
    "timeout": { "startup": 120000 }, // first launch: npx / Docker image to download
    "servers": {
      // Up-to-date library documentation. Optional free API key (higher limits):
      // add  "headers": { "CONTEXT7_API_KEY": "<your key>" }  if you have one.
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "oauth": false
      },
      // AI-driven browser (Microsoft tool). Kit launcher: uses the system Chromium/Chrome if present,
      // otherwise the Playwright one.
      "playwright": {
        "type": "local",
        "command": ["{env:HOME}/.local/bin/oc-playwright-mcp"]
      },
      // Chrome DevTools (Google, Apache-2.0): DOM, console, network and performance
      // inspection in headless, isolated Chrome. Launcher pinned to 1.12.0; telemetry off
      // (--no-usage-statistics, --no-performance-crux, no update check) and a fresh profile
      // per run (--isolated). Requires Chrome/Chromium; tools denied globally ("chrome-devtools_*").
      "chrome-devtools": {
        "type": "local",
        "command": ["{env:HOME}/.local/bin/oc-chrome-devtools-mcp"],
        "timeout": { "startup": 120000 }
      },
      // --- DevOps pack (./install.sh --with devops): disabled with a pack reason otherwise ---
      // Terraform Registry documentation (providers/modules). No TFE_TOKEN: no action on HCP Terraform.
      // Requires Docker or Podman (the launcher picks whichever responds).
      "terraform": {
        "type": "local",
        "command": ["{env:HOME}/.local/bin/oc-terraform-mcp"]
      },
      // Kubernetes READ-ONLY (see k8s-mcp.toml: read_only + Secrets blocked). Uses your kubeconfig.
      "kubernetes": {
        "type": "local",
        "command": ["npx", "-y", "kubernetes-mcp-server@0.1.1", "--config", "{env:HOME}/.config/opencode/k8s-mcp.toml"]
      },
      // Vulnerability / misconfiguration / secret scan (images, IaC, code). Requires `trivy` + mcp plugin (install.sh).
      "trivy": {
        "type": "local",
        "command": ["trivy", "mcp"]
      },
      // SAST (official semgrep-mcp, github.com/semgrep/semgrep). Reserved for the pentest and security agents
      // (see "semgrep_*": "deny" above). Requires uv (already installed for MemPalace) or pipx.
      "semgrep": {
        "type": "local",
        "command": ["{env:HOME}/.local/bin/oc-semgrep-mcp"]
      },
      // --- Internet / GitHub ---
      // Code search across millions of public GitHub repositories (Vercel). No account needed.
      "grep_app": {
        "type": "remote",
        "url": "https://mcp.grep.app",
        "oauth": false
      },
      // Reverse pack (./install.sh --with reverse): binaries, Electron/JS, .NET, APK, firmware, network captures.
      // Reserved for the reverse-engineer agent. Requires Node >= 26.12.1 (or 24.22.1 / 22.23.4):
      // install.sh disables it otherwise (and with a pack reason when the pack is not selected).
      "rea": {
        "type": "local",
        "command": ["{env:HOME}/.local/bin/oc-rea-mcp"]
      },
      // Android module (./install.sh --android): drives the Podman emulator (mobile-mcp, Apache-2.0, pinned version,
      // telemetry off). Not a pack (--with android is an error). Reserved for the android and mobile-tester agents.
      // Disabled by install.sh if the module is not installed.
      "mobile": {
        "type": "local",
        "command": ["{env:HOME}/.local/bin/oc-mobile-mcp"]
      },
      // Lightweight headless browser in Rust (`obscura` binary, installed by install.sh). No --stealth by default.
      "obscura": {
        "type": "local",
        "command": ["obscura", "mcp"]
      }
    }
  }
}
