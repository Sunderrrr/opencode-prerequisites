{
  "$schema": "https://opencode.ai/config.json",

  // Modèles OpenCode Go (vérifie les IDs avec /models : la liste change souvent).
  // Tout tourne sur DeepSeek V4.1 Flash (gros quota : ~216 000 requêtes/mois).
  // Les agents n'ont pas de modèle propre : ils héritent de celui-ci. Pour en changer un,
  // ajoute `model: opencode-go/<id>` dans son fichier agents/<nom>.md.
  "model": "opencode-go/deepseek-v4.1-flash",
  "small_model": "opencode-go/deepseek-v4.1-flash",

  "autoupdate": "notify",

  // Le CEO est l'agent par défaut : il délègue aux spécialistes (agents/*.md)
  "default_agent": "ceo",
  "subagent_depth": 1, // les spécialistes ne lancent pas d'autres sous-agents

  // Compactage natif : buffer "10%" = on compacte quand il reste 10 % de contexte, soit à 90 % d'utilisation.
  "compaction": { "auto": true, "buffer": "10%" },

  // Équivalent du hook de formatage auto de Boris : formate après chaque édition
  "formatter": true,

  // Mémoire persistante (MemPalace) : plugin local plugins/mempalace/ généré par install.sh.
  // On n'utilise pas "plugins": ["@rvboris/opencode-mempalace"] : OpenCode échoue à installer ce paquet
  // (conflit de peerDependencies @opentui/core ^0.5 vs 0.8, erreur ERESOLVE côté npm).

  // Mode débridé : tout est autorisé sans demande. Seules les catastrophes évidentes
  // (rm -rf /, secrets, push --force...) restent bloquées par plugins/guard/.
  "permission": {
    "edit": "allow",
    "bash": { "*": "allow", "rm -rf /*": "deny", "rm -rf ~*": "deny" },
    "webfetch": "allow",
    "websearch": "allow", // recherche web intégrée (Exa/Parallel), sans clé avec le provider OpenCode Go
    "skill": { "*": "allow" },
    // Les ~229 outils du MCP rea ne sont visibles que de l'agent reverse-engineer (qui les autorise dans son fichier) :
    // les montrer à tous les agents alourdirait chaque session.
    "rea_*": "deny",
    // Idem pour les ~34 outils du MCP mobile (module Android : agents android et mobile-tester seulement).
    "mobile_*": "deny",
    // Idem pour le MCP semgrep (SAST) : réservé aux agents pentest et security.
    "semgrep_*": "deny",
    "task": { "*": "allow" }
  },

  // MCP : peu de serveurs, chacun consomme du contexte.
  // Schéma OpenCode v2 : les serveurs sont dans "servers" (la forme plate est obsolète et n'est pas lue par la 2.x).
  // Pour en couper un : ajoute  "disabled": true  dans son bloc.
  "mcp": {
    "timeout": { "startup": 120000 }, // premier lancement : npx / image Docker à télécharger
    "servers": {
      // Documentation à jour des librairies. Clé API gratuite optionnelle (limites plus hautes) :
      // ajoute  "headers": { "CONTEXT7_API_KEY": "<ta clé>" }  si tu en as une.
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "oauth": false
      },
      // Navigateur piloté par l'IA (outil Microsoft). Lanceur du kit : utilise Chromium/Chrome du système s'il existe,
      // sinon celui de Playwright.
      "playwright": {
        "type": "local",
        "command": ["{env:HOME}/.local/bin/oc-playwright-mcp"]
      },
      // --- DevOps (lecture seule / sans écriture) ---
      // Documentation du Terraform Registry (providers/modules). Pas de TFE_TOKEN : aucune action sur HCP Terraform.
      // Nécessite Docker ou Podman (le lanceur choisit celui qui répond).
      "terraform": {
        "type": "local",
        "command": ["{env:HOME}/.local/bin/oc-terraform-mcp"]
      },
      // Kubernetes en LECTURE SEULE (voir k8s-mcp.toml : read_only + Secrets bloqués). Utilise ton kubeconfig.
      "kubernetes": {
        "type": "local",
        "command": ["npx", "-y", "kubernetes-mcp-server@latest", "--config", "{env:HOME}/.config/opencode/k8s-mcp.toml"]
      },
      // Scan de vulnérabilités / misconfigurations / secrets (images, IaC, code). Nécessite `trivy` + plugin mcp (install.sh).
      "trivy": {
        "type": "local",
        "command": ["trivy", "mcp"]
      },
      // SAST (semgrep-mcp officiel, github.com/semgrep/semgrep). Réservé aux agents pentest et security
      // (voir "semgrep_*": "deny" ci-dessus). Nécessite uv (déjà installé pour MemPalace) ou pipx.
      "semgrep": {
        "type": "local",
        "command": ["{env:HOME}/.local/bin/oc-semgrep-mcp"]
      },
      // --- Internet / GitHub ---
      // Recherche de code dans des millions de dépôts GitHub publics (Vercel). Pas de compte.
      "grep_app": {
        "type": "remote",
        "url": "https://mcp.grep.app",
        "oauth": false
      },
      // Rétro-ingénierie (REA, MIT) : binaires, Electron/JS, .NET, APK, firmware, captures réseau. Réservé à l'agent
      // reverse-engineer. Exige Node >= 26.12.1 (ou 24.22.1 / 22.23.4) : désactivé automatiquement par install.sh sinon.
      "rea": {
        "type": "local",
        "command": ["{env:HOME}/.local/bin/oc-rea-mcp"]
      },
      // Module Android (./install.sh --android) : pilotage de l'émulateur Podman (mobile-mcp, Apache-2.0, version épinglée,
      // télémétrie coupée). Réservé aux agents android et mobile-tester. Désactivé par install.sh si le module n'est pas installé.
      "mobile": {
        "type": "local",
        "command": ["{env:HOME}/.local/bin/oc-mobile-mcp"]
      },
      // Navigateur headless léger en Rust (binaire `obscura`, installé par install.sh). Pas de --stealth par défaut.
      "obscura": {
        "type": "local",
        "command": ["obscura", "mcp"]
      }
    }
  }
}
