#!/usr/bin/env bash
# oc-new-web: creates a Vite + React + TypeScript + Tailwind CSS project with a
# token-based design system, ready for OpenCode.
#   oc-new-web <name> [parent-dir]
# The template comes from the repository (templates/web-project), the
# installation (${OPENCODE_CONFIG_DIR:-$HOME/.config/opencode}/templates/web-project)
# or ~/.config/opencode/templates/web-project.
set -Eeuo pipefail

usage() {
  cat <<'EOF'
Usage: oc-new-web <name> [parent-dir]

Creates <parent-dir>/<name> from the web template:
  Vite + React + TypeScript + Tailwind CSS v4, design tokens, light/dark theme,
  accessible demo page, Playwright smoke tests, AGENTS.md and README.md.
  Dependencies are pinned to exact versions.

Arguments:
  name        npm-safe: lowercase letters, digits, ".", "-" and "_";
              starts with a letter; at most 214 characters;
              not "node_modules", "favicon.ico" or "package.json"
  parent-dir  default: current directory (created if missing)

Options:
  -h, --help  this help

Variables:
  OPENCODE_CONFIG_DIR  installation to use (default: ~/.config/opencode)
  OC_NEW_WEB_TEMPLATE  force another template directory (tests)

Template lookup order:
  1. $OC_NEW_WEB_TEMPLATE
  2. <repository>/templates/web-project (when run from the repository)
  3. $OPENCODE_CONFIG_DIR/templates/web-project
  4. ~/.config/opencode/templates/web-project

Examples:
  oc-new-web my-app
  oc-new-web marketing-site ~/Projects
EOF
}

die() { printf '❌ %s\n' "$*" >&2; exit 1; }

case "${1:-}" in
  -h|--help) usage; exit 0 ;;
esac

if [ "$#" -lt 1 ] || [ -z "${1:-}" ]; then
  usage >&2
  exit 1
fi
if [ "$#" -gt 2 ]; then
  printf '❌ Too many arguments (expected: <name> [parent-dir])\n' >&2
  usage >&2
  exit 1
fi

name="$1"
parent="${2:-.}"

# --- npm-safe name (validate-npm-package-name rules) ---
if [ "${#name}" -gt 214 ]; then
  die "Invalid name: too long (${#name} characters, maximum 214)"
fi
case "$name" in
  *[!a-z0-9._-]*) die "Invalid name: \"$name\" (lowercase letters, digits, \".\", \"-\" and \"_\" only)" ;;
esac
case "$name" in
  [a-z]*) ;;
  *) die "Invalid name: \"$name\" (must start with a letter)" ;;
esac
case "$name" in
  *..*) die "Invalid name: \"$name\" (must not contain \"..\")" ;;
  node_modules|favicon.ico|package.json) die "Invalid name: \"$name\" is reserved by npm" ;;
esac

# The directory name is already a valid npm package name.
package="$name"

# --- template: repository first (development), then installation ---
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
tpl=""
for candidate in \
  "${OC_NEW_WEB_TEMPLATE:-}" \
  "$here/../../templates/web-project" \
  "${OPENCODE_CONFIG_DIR:-$HOME/.config/opencode}/templates/web-project" \
  "$HOME/.config/opencode/templates/web-project"
do
  [ -n "$candidate" ] || continue
  if [ -f "$candidate/package.json" ] && [ -f "$candidate/index.html" ] && [ -f "$candidate/src/App.tsx" ]; then
    tpl="$candidate"
    break
  fi
done
[ -n "$tpl" ] || die "Template not found (templates/web-project): rerun ./install.sh or set OC_NEW_WEB_TEMPLATE"

# --- git is required: the generated project starts with a commit ---
command -v git >/dev/null 2>&1 || die "git not found: install git before generating a project"

# --- destination: refuse to overwrite ---
if [ -e "$parent" ] && [ ! -d "$parent" ]; then
  die "Parent path is not a directory: $parent"
fi
[ -d "$parent" ] || mkdir -p "$parent" || die "Cannot create parent directory: $parent"

dest="$parent/$name"
if [ -e "$dest" ] || [ -L "$dest" ]; then
  die "$dest already exists"
fi

created=0
cleanup() {
  status=$?
  if [ "$status" -ne 0 ] && [ "$created" = 1 ] && [ -d "$dest" ]; then
    rm -rf "$dest"
  fi
}
trap cleanup EXIT

mkdir -p "$dest"
created=1
cp -a "$tpl/." "$dest/"

# --- substitutions ({{name}} = project name, {{package}} = npm package name) ---
find "$dest" -type f -print | while IFS= read -r file; do
  if grep -q '{{' "$file" 2>/dev/null; then
    sed -i.bak \
      -e "s/{{name}}/$name/g" \
      -e "s/{{package}}/$package/g" \
      "$file"
    rm -f "$file.bak"
  fi
done

if grep -Rq '{{' "$dest" 2>/dev/null; then
  die "Unreplaced placeholders remain in $dest (incomplete template?)"
fi

# --- initial git repository ---
if ! git -C "$dest" init -q -b main 2>/dev/null; then
  git -C "$dest" init -q
  git -C "$dest" symbolic-ref HEAD refs/heads/main
fi
git -C "$dest" add -A

git_name="${GIT_AUTHOR_NAME:-$(git config user.name 2>/dev/null || true)}"
git_email="${GIT_AUTHOR_EMAIL:-$(git config user.email 2>/dev/null || true)}"
[ -n "$git_name" ] || git_name="dev"
[ -n "$git_email" ] || git_email="dev@localhost"

git -C "$dest" -c user.name="$git_name" -c user.email="$git_email" \
  commit -q -m "Initial commit"

trap - EXIT
abs="$(cd "$dest" && pwd -P)"
printf '✅ Web project created: %s\n' "$abs"
printf '   package: %s\n' "$package"
printf '   next   : cd %s && npm install\n' "$abs"
printf '   dev    : npm run dev\n'
printf '   build  : npm run build\n'
printf '   e2e    : npx playwright install chromium && npm run test:e2e\n'
