#!/usr/bin/env bash
# REA CLI (Reverse Engineer Anything, MIT) at a pinned version.
#   oc-rea --version
#   oc-rea analyze-javascript-application /absolute/path --json
#   oc-rea --check    only checks that Node is recent enough (exit 0/1)
# The MCP server has its own launcher: oc-rea-mcp.
# REA requires Node ^22.23.4 || ^24.22.1 || >=26.12.1.
# Variables: OC_REA_VERSION (package version), OC_REA_NODE_VERSION (tests).
set -Eeuo pipefail
REA_VERSION="${OC_REA_VERSION:-6.8.0}"

node_ok() {
  local v="${OC_REA_NODE_VERSION:-}"
  [ -n "$v" ] || v="$(node -p 'process.versions.node' 2>/dev/null)" || return 1
  node -e '
    const [a, b, c] = process.argv[1].split(".").map(Number)
    const ge = (x, y, z) => a > x || (a === x && (b > y || (b === y && c >= z)))
    process.exit((a === 22 && ge(22, 23, 4)) || (a === 24 && ge(24, 22, 1)) || (a >= 26 && ge(26, 12, 1)) ? 0 : 1)
  ' "$v"
}

if ! node_ok; then
  have="${OC_REA_NODE_VERSION:-$(node -v 2>/dev/null || printf 'absent')}"
  printf 'REA %s requires Node ^22.23.4 || ^24.22.1 || >=26.12.1 (current version: %s).\n' "$REA_VERSION" "$have" >&2
  printf 'With mise: mise use -g node@26.12.1   (or recent node@24 / node@22), then rerun ./install.sh --no-tools\n' >&2
  exit 1
fi
[ "${1:-}" = "--check" ] && exit 0

exec npx -y "rea-agents@${REA_VERSION}" "$@"
