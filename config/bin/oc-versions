#!/usr/bin/env bash
# oc-versions: latest real package versions (24 h cache).
#   oc-versions npm @playwright/mcp
#   oc-versions pypi semgrep-mcp
#   oc-versions android
# See "oc-versions --help" (TTL, cache and fixtures through environment variables).
set -Eeuo pipefail

here="$(cd -- "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
config="${OPENCODE_CONFIG_DIR:-$HOME/.config/opencode}"

# From the repository: ../libexec/oc-versions.mjs; installed: <config>/libexec/oc-versions.mjs.
if [ -f "$here/../libexec/oc-versions.mjs" ]; then
  exec node "$here/../libexec/oc-versions.mjs" "$@"
fi
if [ -f "$config/libexec/oc-versions.mjs" ]; then
  exec node "$config/libexec/oc-versions.mjs" "$@"
fi

printf '❌ oc-versions: oc-versions.mjs not found (neither %s nor %s)\n' \
  "$here/../libexec" "$config/libexec" >&2
exit 127
