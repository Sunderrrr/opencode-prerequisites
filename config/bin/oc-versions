#!/usr/bin/env bash
# oc-versions : dernières versions réelles des paquets (cache 24 h).
#   oc-versions npm @playwright/mcp
#   oc-versions pypi semgrep-mcp
#   oc-versions android
# Voir « oc-versions --help » (TTL, cache et fixtures par variables d'environnement).
set -Eeuo pipefail

here="$(cd -- "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
config="${OPENCODE_CONFIG_DIR:-$HOME/.config/opencode}"

# Depuis le dépôt : ../libexec/oc-versions.mjs ; installé : <config>/libexec/oc-versions.mjs.
if [ -f "$here/../libexec/oc-versions.mjs" ]; then
  exec node "$here/../libexec/oc-versions.mjs" "$@"
fi
if [ -f "$config/libexec/oc-versions.mjs" ]; then
  exec node "$config/libexec/oc-versions.mjs" "$@"
fi

printf '❌ oc-versions : oc-versions.mjs introuvable (ni %s ni %s)\n' \
  "$here/../libexec" "$config/libexec" >&2
exit 127
