#!/usr/bin/env bash
# Starts the official Semgrep MCP server (SAST, LGPL-2.1/MIT, github.com/semgrep/semgrep) through uvx.
#   oc-semgrep-mcp                MCP server (stdio), used by OpenCode (pentest/security agents)
#   oc-semgrep-mcp --check        really starts the server, checks the MCP "initialize" handshake
#                                 (exit 0/1); kills the process at the end and prints a stderr excerpt on failure
#   oc-semgrep-mcp --check-quick  only checks that uvx (or pipx) is in PATH: no process
#                                 started, no network access, no file written (exit 0/1). Used by
#                                 ./install.sh --no-tools, which must not download anything.
# No account or token required locally (default community rules).
#
# Pinned versions (no implicit @latest):
#   semgrep-mcp 0.9.0 (latest on PyPI) publishes mcp==1.12.2 and semgrep==1.135.0.
#   - INTENTIONAL PIN pydantic 2.11.10: mcp 1.12.2 imports
#     pydantic._internal._typing_extra.eval_type_backport, removed in pydantic 2.12+:
#     without the constraint, uv resolves pydantic 2.14.x and the server dies on ImportError.
#   - INTENTIONAL PIN setuptools 80.10.2: semgrep 1.135.0 imports opentelemetry.instrumentation,
#     which imports pkg_resources: setuptools 82+ no longer ships pkg_resources (81 only prints
#     a deprecation warning). Without it, `semgrep --version` fails in the uvx environment and
#     the MCP server dies at startup ("Semgrep is not installed or not in your PATH").
#   Both pins are listed in oc-deps' intentional list (with the same reasons), so
#   "oc-deps check" reports them as intentional instead of drift. Do not bump them
#   without revalidating `oc-semgrep-mcp --check`.
#
# Python interpreter: pydantic 2.11.10 depends on pydantic-core 2.33.2, which has no wheel
# for Python 3.14/3.15. With the default system Python, uv then tries a
# maturin/Cargo build and fails ("Cargo metadata failed … no default toolchain") for lack of a
# Rust toolchain. So we force a 3.10–3.13 interpreter: uv uses a compliant system Python when one
# exists, otherwise it downloads a managed CPython (~30 MB the first time).
#
# Variables (override without editing this file):
#   OC_SEMGREP_MCP_VERSION        semgrep-mcp version                   (default: 0.9.0)
#   OC_SEMGREP_PYDANTIC_VERSION   pydantic version                      (default: 2.11.10)
#   OC_SEMGREP_SETUPTOOLS_VERSION setuptools version                    (default: 80.10.2)
#   OC_SEMGREP_PYTHON             interpreter for uvx/pipx              (default: '>=3.10,<3.14')
#                                 e.g. 3.12, python3.12, /opt/py/bin/python3.12
#   OC_SEMGREP_CHECK_TIMEOUT      max --check duration, in seconds      (default: 180)
set -Eeuo pipefail

# GUI-launched OpenCode Desktop does not inherit the shell PATH (Electron): load the kit PATH.
# shellcheck disable=SC1091
for d in "${OPENCODE_CONFIG_DIR:-$HOME/.config/opencode}/libexec" "$HOME/.config/opencode/libexec" "$(cd "${BASH_SOURCE[0]%/*}/../libexec" 2>/dev/null && pwd)"; do [ -r "$d/desktop-env.sh" ] && . "$d/desktop-env.sh" && break; done

MCP_VERSION="${OC_SEMGREP_MCP_VERSION:-0.9.0}"
PYDANTIC_VERSION="${OC_SEMGREP_PYDANTIC_VERSION:-2.11.10}"
SETUPTOOLS_VERSION="${OC_SEMGREP_SETUPTOOLS_VERSION:-80.10.2}"
CHECK_TIMEOUT="${OC_SEMGREP_CHECK_TIMEOUT:-180}"

DEFAULT_PYTHON=">=3.10,<3.14"
PYTHON_SPEC="${OC_SEMGREP_PYTHON:-$DEFAULT_PYTHON}"

# --check-quick: launcher presence only, BEFORE any command construction (the pipx branch
# below writes a constraints file and runs "pipx run --help"). command -v and echo are
# builtins: no subprocess, no network access, no file — which is what ./install.sh --no-tools requires.
if [ "${1:-}" = "--check-quick" ]; then
  if command -v uvx >/dev/null 2>&1; then
    echo "semgrep-mcp ${MCP_VERSION}: uvx detected — launcher available (startup not tested; use --check for the MCP handshake)"
    exit 0
  fi
  if command -v pipx >/dev/null 2>&1; then
    echo "semgrep-mcp ${MCP_VERSION}: pipx detected (uvx missing) — launcher available (startup not tested; use --check for the MCP handshake)"
    exit 0
  fi
  echo "semgrep-mcp ${MCP_VERSION}: neither uvx nor pipx in PATH." >&2
  echo "  Install uv (recommended): curl -LsSf https://astral.sh/uv/install.sh | sh" >&2
  echo "  or pipx: https://pipx.pypa.io — then rerun this check." >&2
  exit 1
fi

constraints=""
runner=()
runner_kind=""
pipx_python=""
if command -v uvx >/dev/null 2>&1; then
  runner_kind=uv
  # --python: uv takes a compliant system interpreter or downloads one (managed CPython).
  runner=(uvx --python "$PYTHON_SPEC"
              --from "semgrep-mcp==${MCP_VERSION}"
              --with "pydantic==${PYDANTIC_VERSION}"
              --with "setuptools==${SETUPTOOLS_VERSION}"
              semgrep-mcp)
elif command -v pipx >/dev/null 2>&1; then
  runner_kind=pipx
  # pipx has no --with equivalent: constrain its venv dependencies through PIP_CONSTRAINT.
  constraints="${XDG_CACHE_HOME:-$HOME/.cache}/oc-semgrep-mcp/pipx-constraints.txt"
  mkdir -p "$(dirname "$constraints")"
  printf 'pydantic==%s\nsetuptools==%s\n' "$PYDANTIC_VERSION" "$SETUPTOOLS_VERSION" > "$constraints"
  export PIP_CONSTRAINT="$constraints"

  # pipx --python does not accept a version spec: give it an interpreter that is present,
  # otherwise (recent pipx) make it download a standalone CPython compatible with the wheels.
  pipx_python="${OC_SEMGREP_PYTHON:-}"
  if [ -z "$pipx_python" ]; then
    for cand in python3.13 python3.12 python3.11 python3.10; do
      if command -v "$cand" >/dev/null 2>&1; then pipx_python="$cand"; break; fi
    done
  fi
  fetch=()
  if [ -z "$pipx_python" ]; then
    if pipx run --help 2>/dev/null | grep -q -- '--fetch-missing-python'; then
      pipx_python=3.12
      fetch=(--fetch-missing-python)
    else
      echo "semgrep-mcp: no Python 3.10–3.13 on this machine and this pipx cannot download one." >&2
      echo "  Install uv (recommended): curl -LsSf https://astral.sh/uv/install.sh | sh" >&2
      echo "  or a compatible Python (Debian/Ubuntu: sudo apt install python3.12; Arch: python312 from AUR)." >&2
      exit 1
    fi
  fi
  runner=(pipx run --python "$pipx_python" ${fetch[@]+"${fetch[@]}"}
              --spec "semgrep-mcp==${MCP_VERSION}" semgrep-mcp)
else
  echo "semgrep-mcp requires uvx (or pipx). Install uv: curl -LsSf https://astral.sh/uv/install.sh | sh" >&2
  exit 1
fi

# Cleanup of the --check temporary directory (global variable: the trap must not freeze
# the local "$dir" of check(), otherwise shellcheck SC2064 and a leak if the path changes).
check_dir=""
cleanup() { [ -z "$check_dir" ] || rm -rf "$check_dir"; }
trap cleanup EXIT

# Last useful stderr lines (cuts uv progress bars, very noisy).
stderr_excerpt() {
  tr '\r' '\n' < "$1" 2>/dev/null \
    | grep -v -E '^[[:space:]]*$' \
    | grep -v -E '(Downloading|Downloaded|Prepared|Installed|Resolved|Audited|Building|Built|Updating|Creating virtual environment)' \
    | tail -n 12 \
    | sed 's/^/    /' || true
}

# Interpreter actually used (best-effort, downloads nothing): useful for support.
python_used() {
  local p v
  [ "$runner_kind" = uv ] || return 0
  command -v uv >/dev/null 2>&1 || return 0
  p="$(uv python find --no-python-downloads "$PYTHON_SPEC" 2>/dev/null || true)"
  [ -n "$p" ] || return 0
  v="$("$p" -c 'import sys; print("%d.%d.%d" % sys.version_info[:3])' 2>/dev/null || true)"
  printf '%s' "$v"
}

# "name version" from the initialize response (JSON-RPC on stdout).
server_info() {
  local info name ver
  info="$(grep -o '"serverInfo"[^}]*}' "$1" 2>/dev/null | head -n 1 || true)"
  [ -n "$info" ] || return 0
  name="$(printf '%s' "$info" | sed -n 's/.*"name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')"
  ver="$(printf '%s' "$info" | sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')"
  if [ -n "$name" ] && [ -n "$ver" ]; then printf '%s %s' "$name" "$ver"
  elif [ -n "$name" ]; then printf '%s' "$name"
  fi
}

check() {
  local dir rc pid end out err info py msg
  dir="$(mktemp -d "${TMPDIR:-/tmp}/oc-semgrep-mcp.XXXXXX")"
  check_dir="$dir"
  out="$dir/out" err="$dir/err"

  printf '%s\n' \
    '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-06-18","capabilities":{},"clientInfo":{"name":"oc-semgrep-mcp-check","version":"1"}}}' \
    > "$dir/request.jsonl"

  # Bound the time: timeout(1) when present, otherwise a portable equivalent (loop + kill).
  if command -v timeout >/dev/null 2>&1; then
    rc=0
    timeout --kill-after=5 "$CHECK_TIMEOUT" "${runner[@]}" \
      < "$dir/request.jsonl" > "$out" 2> "$err" || rc=$?
  else
    "${runner[@]}" < "$dir/request.jsonl" > "$out" 2> "$err" &
    pid=$!
    end=$((SECONDS + CHECK_TIMEOUT))
    while kill -0 "$pid" 2>/dev/null && [ "$SECONDS" -lt "$end" ]; do sleep 0.2; done
    if kill -0 "$pid" 2>/dev/null; then
      kill "$pid" 2>/dev/null || true
      wait "$pid" 2>/dev/null || true
      rc=124
    else
      rc=0
      wait "$pid" 2>/dev/null || rc=$?
    fi
  fi

  # Success = JSON-RPC response to initialize (serverInfo), server exited cleanly on stdin EOF.
  if [ "$rc" -eq 0 ] && grep -q '"serverInfo"' "$out" 2>/dev/null; then
    info="$(server_info "$out")"
    py="$(python_used)"
    msg="semgrep-mcp ${MCP_VERSION}: MCP initialize handshake OK"
    [ -z "$info" ] || msg="$msg — serverInfo ${info}"
    [ -z "$py" ] || msg="$msg — Python ${py}"
    echo "$msg"
    return 0
  fi

  {
    echo "semgrep-mcp ${MCP_VERSION}: no valid MCP initialize response (code ${rc})."
    case "$rc" in
      124|137)
        echo "  Timed out after ${CHECK_TIMEOUT}s: the first run downloads the packages (~50 MB) and, if needed, a managed CPython (~30 MB)."
        echo "  Retry (the uv cache is reused) or increase OC_SEMGREP_CHECK_TIMEOUT."
        ;;
    esac
    if grep -qiE 'maturin|Cargo metadata|no default toolchain|rustup' "$err" 2>/dev/null; then
      echo "  A dependency had to be compiled: the selected Python (${PYTHON_SPEC}) has no wheel."
      echo "  Force a managed interpreter: OC_SEMGREP_PYTHON=3.12 $(basename "$0") --check"
      echo "  (equivalent: uv python install 3.12; uv downloads it automatically)."
    fi
    if grep -q '"error"' "$out" 2>/dev/null; then
      echo "  JSON-RPC error response:"
      tail -n 2 "$out" | sed 's/^/    /'
    fi
    if [ -s "$err" ]; then
      echo "  Last stderr lines:"
      stderr_excerpt "$err"
    fi
  } >&2
  return 1
}

if [ "${1:-}" = "--check" ]; then
  if check; then exit 0; else exit 1; fi
fi

# Normal launch: clean exec, no stray output on stdout (MCP protocol).
exec "${runner[@]}" "$@"
