#!/usr/bin/env bash
# Lance le MCP mobile-mcp (mobile-next, Apache-2.0) : piloter un émulateur / téléphone Android (et iOS sous macOS),
# version épinglée, télémétrie désactivée, adb retrouvé via ANDROID_HOME.
#   oc-mobile-mcp            serveur MCP (stdio), utilisé par OpenCode
#   oc-mobile-mcp --check    vérifie seulement qu'adb est trouvable (code 0/1)
# Variables : OC_MOBILE_VERSION (version du paquet), MOBILEMCP_DISABLE_TELEMETRY=0 pour réactiver la télémétrie.
set -Eeuo pipefail
MOBILE_VERSION="${OC_MOBILE_VERSION:-1.0.15}"

# SDK Android : variable d'environnement, sinon emplacements usuels
if [ -z "${ANDROID_HOME:-}" ]; then
  for d in "${ANDROID_SDK_ROOT:-}" "$HOME/Android/Sdk" "$HOME/Library/Android/sdk" /opt/android-sdk /usr/lib/android-sdk; do
    if [ -n "$d" ] && [ -d "$d/platform-tools" ]; then export ANDROID_HOME="$d"; break; fi
  done
fi
if [ -n "${ANDROID_HOME:-}" ] && [ -d "$ANDROID_HOME/platform-tools" ]; then
  export PATH="$PATH:$ANDROID_HOME/platform-tools"
fi

if ! command -v adb >/dev/null 2>&1; then
  echo "adb introuvable : installe les Android Platform Tools (Arch : sudo pacman -S android-tools ; Debian/Ubuntu : sudo apt install adb ; Fedora : sudo dnf install android-tools) ou définis ANDROID_HOME." >&2
  exit 1
fi
[ "${1:-}" = "--check" ] && exit 0

export MOBILEMCP_DISABLE_TELEMETRY="${MOBILEMCP_DISABLE_TELEMETRY:-1}"
exec npx -y "@mobilenext/mobile-mcp@${MOBILE_VERSION}" "$@"
