#!/usr/bin/env bash
# Lance le MCP Playwright (Microsoft) avec le navigateur du système s'il existe
# (Arch/Omarchy, Fedora, Debian, Ubuntu...), sinon avec le Chromium téléchargé par Playwright.
#   OC_PLAYWRIGHT_HEADED=1   fenêtre visible (sinon : headless quand on utilise le navigateur système)
#   OC_PLAYWRIGHT_BROWSER=/chemin/vers/navigateur   force un navigateur précis
set -Eeuo pipefail

exe="${OC_PLAYWRIGHT_BROWSER:-}"
if [ -z "$exe" ]; then
  for c in chromium chromium-browser google-chrome-stable google-chrome brave-browser brave; do
    if p="$(command -v "$c" 2>/dev/null)"; then exe="$p"; break; fi
  done
fi

# Version épinglée (dernière stable vérifiée : 0.0.84) : pas de @latest surprise au démarrage.
pkg="@playwright/mcp@0.0.84"

# Sans navigateur système, args resterait vide : en bash 3.2 (macOS), "${args[@]}" avec set -u
# échoue (« unbound variable »). On lance donc npx dans deux branches distinctes.
if [ -z "$exe" ]; then
  exec npx -y "$pkg" "$@"
fi

args=(--executable-path "$exe")
[ "${OC_PLAYWRIGHT_HEADED:-0}" = 1 ] || args+=(--headless)
# Navigateur lancé en root (conteneur) : le sandbox Chromium est impossible
[ "$(id -u)" -ne 0 ] || args+=(--no-sandbox)

exec npx -y "$pkg" "${args[@]}" "$@"
