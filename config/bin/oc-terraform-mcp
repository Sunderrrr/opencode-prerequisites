#!/usr/bin/env bash
# Terraform MCP (registry only, no token) through Docker or Podman.
# Picks the engine that actually answers (an installed but stopped Docker is skipped in favor of Podman).
set -Eeuo pipefail

# GUI-launched OpenCode Desktop does not inherit the shell PATH (Electron): load the kit PATH.
# shellcheck disable=SC1091
for d in "${OPENCODE_CONFIG_DIR:-$HOME/.config/opencode}/libexec" "$HOME/.config/opencode/libexec" "$(cd "$(dirname "$0")/../libexec" 2>/dev/null && pwd)"; do [ -r "$d/desktop-env.sh" ] && . "$d/desktop-env.sh" && break; done

# macOS has no "timeout": use coreutils (gtimeout) when present, otherwise do not bound the test.
# Without a bound, a stopped Docker daemon can make the client wait: try Podman first.
TO=""
if command -v timeout >/dev/null 2>&1; then TO=timeout
elif command -v gtimeout >/dev/null 2>&1; then TO=gtimeout
fi

rt=""; first=""
probe() {
  if [ -n "$TO" ]; then "$TO" 8 "$1" info >/dev/null 2>&1
  else "$1" info >/dev/null 2>&1
  fi
}
choose() {
  local c
  for c in "$@"; do
    command -v "$c" >/dev/null 2>&1 || continue
    [ -n "$first" ] || first="$c"
    if probe "$c"; then rt="$c"; return 0; fi
  done
  return 0
}

# Historical order (Docker first) when the test can be bounded; Podman first otherwise.
if [ -n "$TO" ]; then choose docker podman
else choose podman docker
fi
rt="${rt:-$first}"
[ -n "$rt" ] || { echo "Neither docker nor podman is installed (required for the terraform MCP)." >&2; exit 1; }

# Full image name: works the same with Docker and Podman
exec "$rt" run -i --rm docker.io/hashicorp/terraform-mcp-server:1.4.1 stdio --toolsets=registry "$@"
