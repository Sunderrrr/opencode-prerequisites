#!/usr/bin/env bash
# Lance le serveur MCP REA (Reverse Engineer Anything, MIT) en version épinglée.
#   oc-rea-mcp            serveur MCP (stdio), utilisé par OpenCode
#   oc-rea-mcp --check    vérifie seulement que Node est assez récent (code 0/1)
# REA exige Node ^22.23.4 || ^24.22.1 || >=26.12.1.
# Variables : OC_REA_VERSION (version du paquet), REA_MCP_INPUT_SCHEMA_PROFILE=full (descriptions d'outils complètes).
set -Eeuo pipefail
REA_VERSION="${OC_REA_VERSION:-6.8.0}"

node_ok() {
  local v="${OC_REA_NODE_VERSION:-}"
  [ -n "$v" ] || v="$(node -p 'process.versions.node' 2>/dev/null)" || return 1
  node -e '
    const [a, b, c] = process.argv[1].split(".").map(Number)
    const ge = (x, y, z) => a > x || (a === x && (b > y || (b === y && c >= z)))
    process.exit((a === 22 && ge(22, 23, 4)) || (a === 24 && ge(24, 22, 1)) || (a >= 26 && ge(26, 12, 1)) ? 0 : 1)
  ' "$v"
}

if ! node_ok; then
  have="${OC_REA_NODE_VERSION:-$(node -v 2>/dev/null || echo 'absent')}"
  echo "REA ${REA_VERSION} demande Node ^22.23.4 || ^24.22.1 || >=26.12.1 (version actuelle : ${have})." >&2
  echo "Avec mise : mise use -g node@26.12.1   (ou node@24 / node@22 récents), puis relance ./install.sh --no-tools" >&2
  exit 1
fi
[ "${1:-}" = "--check" ] && exit 0

exec npx -y "rea-agents@${REA_VERSION}" mcp "$@"
