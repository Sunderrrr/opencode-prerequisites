#!/usr/bin/env bash
# Starts the REA MCP server (Reverse Engineer Anything, MIT) at a pinned version.
#   oc-rea-mcp            MCP server (stdio), used by OpenCode
#   oc-rea-mcp --check    only checks that Node is recent enough (exit 0/1)
# REA requires Node ^22.23.4 || ^24.22.1 || >=26.12.1.
# Variables: OC_REA_VERSION (package version), REA_MCP_INPUT_SCHEMA_PROFILE=full (full tool descriptions).
set -Eeuo pipefail

# GUI-launched OpenCode Desktop does not inherit the shell PATH (Electron): load the kit PATH.
# shellcheck disable=SC1091
for d in "${OPENCODE_CONFIG_DIR:-$HOME/.config/opencode}/libexec" "$HOME/.config/opencode/libexec" "$(cd "$(dirname "$0")/../libexec" 2>/dev/null && pwd)"; do [ -r "$d/desktop-env.sh" ] && . "$d/desktop-env.sh" && break; done
REA_VERSION="${OC_REA_VERSION:-6.8.0}"

node_ok() {
  local v="${OC_REA_NODE_VERSION:-}"
  [ -n "$v" ] || v="$(node -p 'process.versions.node' 2>/dev/null)" || return 1
  node -e '
    const [a, b, c] = process.argv[1].split(".").map(Number)
    const ge = (x, y, z) => a > x || (a === x && (b > y || (b === y && c >= z)))
    process.exit((a === 22 && ge(22, 23, 4)) || (a === 24 && ge(24, 22, 1)) || (a >= 26 && ge(26, 12, 1)) ? 0 : 1)
  ' "$v"
}

if ! node_ok; then
  have="${OC_REA_NODE_VERSION:-$(node -v 2>/dev/null || echo 'absent')}"
  echo "REA ${REA_VERSION} requires Node ^22.23.4 || ^24.22.1 || >=26.12.1 (current version: ${have})." >&2
  echo "With mise: mise use -g node@26.12.1   (or recent node@24 / node@22), then rerun ./install.sh --no-tools" >&2
  exit 1
fi
[ "${1:-}" = "--check" ] && exit 0

exec npx -y "rea-agents@${REA_VERSION}" mcp "$@"
