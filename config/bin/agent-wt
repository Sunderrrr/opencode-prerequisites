#!/usr/bin/env bash
# agent-wt: one isolated git worktree per agent task, to avoid conflicts in parallel work.
# Bash 3.2+ (macOS/Linux), no dependency beyond git.
#
#   agent-wt new <task> [base] [--agent <name>] [--session <id>]
#       creates .worktrees/<task> on branch agent/<task> from <base> (default HEAD)
#       and writes .worktrees/<task>/task: task=, branch=, agent= (when provided),
#       sessionID= (when provided), created= (UTC ISO 8601). The task file is ignored by
#       git through the '.worktrees/' and '/task' patterns in .git/info/exclude (never
#       .gitignore), otherwise it would make every worktree "dirty".
#   agent-wt merge <task>
#       merges agent/<task> into the current branch of the main repository.
#   agent-wt remove <task> [--force]
#       removes the worktree and the branch; refuses uncommitted changes without
#       --force; an unmerged branch is kept (explicit message).
#   agent-wt list [--porcelain]
#       default: git worktree list (human-readable). --porcelain: one line per worktree,
#       7 tab-separated fields: task, branch, dirty, ahead, behind,
#       short commit, path. task = "-" for the main repository; branch = "-" when
#       HEAD is detached; dirty = 0/1; ahead/behind = commits in the worktree missing from
#       the main HEAD / commits in the main HEAD missing from the worktree. No header.
#       Limit: a path containing a tab or a newline breaks the format.
#   agent-wt registry [--out <file>]
#       Markdown table of agent worktrees (task files without a worktree are
#       ignored). Without --out, writes to stdout: 'registry > REGISTRY.md' overwrites the
#       file, because the shell truncates it before execution. With --out, the
#       "## History" section of the existing file is copied to the end (append), so that
#       the CEO keeps the trace after compaction.
#   agent-wt integration <name> [base]
#       creates branch integration/<name> from origin/<base> (default main) for a single PR.
#   agent-wt sync [base]
#       rebases the current branch onto origin/<base> (exit 2 + files on conflict).
#
# Known limits: locked worktree (git worktree lock) not unlocked here;
# submodules not initialized in new worktrees; paths with newlines
# not handled by the porcelain format.
set -Eeuo pipefail

# GUI-launched OpenCode Desktop does not inherit the shell PATH (Electron): load the kit PATH.
# shellcheck disable=SC1091
for d in "${OPENCODE_CONFIG_DIR:-$HOME/.config/opencode}/libexec" "$HOME/.config/opencode/libexec" "$(cd "$(dirname "$0")/../libexec" 2>/dev/null && pwd)"; do [ -r "$d/desktop-env.sh" ] && . "$d/desktop-env.sh" && break; done
IFS=$'\n\t'

# Physical path of an existing directory, without symlinks: 'pwd -P' avoids a
# realpath dependency and works on bash 3.2 (macOS). A missing directory (for
# example a worktree deleted by hand) is returned unchanged: nothing to resolve.
canon_dir() {
  local dir="$1" physical
  if physical="$(cd -- "$dir" 2>/dev/null && pwd -P)"; then
    printf '%s' "$physical"
  else
    printf '%s' "$dir"
  fi
}

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || {
  printf '❌ agent-wt: not inside a git repository\n' >&2
  exit 1
}
# If we are in a worktree, go back to the main repository: the first record
# of 'git worktree list' is always the main repository. awk sub() keeps spaces.
MAIN="$(cd "$ROOT" && git worktree list --porcelain | awk '/^worktree /{sub(/^worktree /, ""); print; exit}')"
# git reports resolved paths (/private/var/... on macOS) while $TMPDIR may be a
# symlink (/var/...): normalize MAIN so every comparison and printed path uses
# the same canonical form.
MAIN="$(canon_dir "$MAIN")"
WT_DIR="$(canon_dir "$MAIN/.worktrees")"
MAIN_HEAD="$(git -C "$MAIN" rev-parse HEAD 2>/dev/null || true)"
cmd="${1:-}"
task="${2:-}"

die() {
  printf '❌ %s\n' "$*" >&2
  exit 1
}

usage_text() {
  cat <<'EOF'
usage: agent-wt <command> [arguments]
  new <task> [base] [--agent <name>] [--session <id>]
  merge <task>
  remove <task> [--force]
  list [--porcelain]
  registry [--out <file>]
  integration <name> [base]
  sync [base]
EOF
}

usage() {
  local code="${1:-1}"
  if [ "$code" -eq 0 ]; then
    usage_text
  else
    usage_text >&2
  fi
  exit "$code"
}

# Task name = directory name and branch suffix: no space, no '/', no '..', no
# leading '-'. The first alphanumeric character excludes '.', '..' and '-evil'.
safe() {
  local name="$1"
  [[ "$name" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || die "Invalid task name: $name"
  case "$name" in
    *..* | *.lock | *.) die "Invalid task name (reserved by git): $name" ;;
  esac
}

# Values written to the task file: no space, newline or '|'.
safe_value() {
  local value="$1" what="$2"
  [[ "$value" =~ ^[A-Za-z0-9._@:-]+$ ]] || die "Invalid $what value: $value"
}

ensure_exclude() {
  local pattern="$1" file="$MAIN/.git/info/exclude"
  if ! grep -qxF -- "$pattern" "$file" 2>/dev/null; then
    printf '%s\n' "$pattern" >>"$file"
  fi
  return 0
}

# Task name of a worktree: '-' for the main repository or a path outside .worktrees.
task_name() {
  local path="$1" name="-"
  case "$path" in
    "$WT_DIR"/*)
      name="${path#"$WT_DIR"/}"
      case "$name" in
        */*) name="-" ;;
      esac
      ;;
  esac
  printf '%s' "$name"
}

# Computes the fields of a worktree then calls $1 with:
# task, branch, dirty, ahead, behind, short commit, path.
emit_record() {
  local cb="$1" path="$2" ref="$3"
  local name dirty=0 ahead=0 behind=0 commit="-" branch="-" counts
  # Same canonical form as WT_DIR (git may report a path going through a symlink).
  path="$(canon_dir "$path")"
  name="$(task_name "$path")"
  if [ -n "$ref" ]; then
    branch="${ref#refs/heads/}"
  fi
  if [ -d "$path" ] && git -C "$path" rev-parse --git-dir >/dev/null 2>&1; then
    if [ -n "$(git -C "$path" status --porcelain 2>/dev/null || true)" ]; then
      dirty=1
    fi
    commit="$(git -C "$path" rev-parse --short HEAD 2>/dev/null || printf '%s' '-')"
    if [ -n "$MAIN_HEAD" ]; then
      counts="$(git -C "$path" rev-list --left-right --count "$MAIN_HEAD...HEAD" 2>/dev/null || true)"
      if [ -n "$counts" ]; then
        read -r behind ahead <<<"$counts" || true
      fi
    fi
  else
    # Worktree deleted by hand: still show it, marked as "dirty".
    dirty=1
  fi
  "$cb" "$name" "$branch" "$dirty" "$ahead" "$behind" "$commit" "$path"
}

# Walks 'git worktree list --porcelain' without losing paths with spaces.
# $1 = render function, called by emit_record.
worktree_records() {
  local cb="$1" w_path="" w_branch="" line
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      "worktree "*)
        if [ -n "$w_path" ]; then
          emit_record "$cb" "$w_path" "$w_branch"
        fi
        w_path="${line#worktree }"
        w_branch=""
        ;;
      "branch "*) w_branch="${line#branch }" ;;
      "")
        if [ -n "$w_path" ]; then
          emit_record "$cb" "$w_path" "$w_branch"
        fi
        w_path=""
        w_branch=""
        ;;
    esac
  done < <(git -C "$MAIN" worktree list --porcelain)
  if [ -n "$w_path" ]; then
    emit_record "$cb" "$w_path" "$w_branch"
  fi
}

row_porcelain() {
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$1" "$2" "$3" "$4" "$5" "$6" "$7"
}

md_escape() {
  printf '%s' "${1//|/\\|}"
}

row_markdown() {
  # The main repository, worktrees outside .worktrees and vanished worktrees
  # (git metadata without a directory) are not tasks.
  [ "$1" = "-" ] && return 0
  [ -d "$7" ] || return 0
  printf '| %s | %s | %s | %s/%s | %s | %s |\n' \
    "$1" "$2" "$3" "$4" "$5" "$6" "$(md_escape "$7")"
}

case "$cmd" in
  new)
    safe "$task"
    shift 2
    base="HEAD"
    agent=""
    session=""
    positional=0
    while [ $# -gt 0 ]; do
      case "$1" in
        --agent)
          [ $# -ge 2 ] || die "--agent: missing value"
          agent="$2"
          shift 2
          ;;
        --session)
          [ $# -ge 2 ] || die "--session: missing value"
          session="$2"
          shift 2
          ;;
        --)
          shift
          [ $# -le 1 ] || die "too many arguments after --"
          if [ $# -eq 1 ]; then
            [ "$positional" -eq 0 ] || die "too many arguments: $1"
            base="$1"
            positional=1
            shift
          fi
          ;;
        -*)
          die "unknown option: $1 (see agent-wt --help)"
          ;;
        *)
          [ "$positional" -eq 0 ] || die "too many arguments: $1"
          base="$1"
          positional=1
          shift
          ;;
      esac
    done
    case "$base" in
      -*) die "invalid base: $base" ;;
    esac
    if [ -n "$agent" ]; then
      safe_value "$agent" "agent"
    fi
    if [ -n "$session" ]; then
      safe_value "$session" "session"
    fi
    if git -C "$MAIN" show-ref --verify --quiet "refs/heads/agent/$task"; then
      die "branch agent/$task already exists"
    fi
    if [ -e "$WT_DIR/$task" ]; then
      die "worktree already exists: $WT_DIR/$task"
    fi
    mkdir -p "$WT_DIR"
    WT_DIR="$(canon_dir "$WT_DIR")"
    ensure_exclude '.worktrees/'
    ensure_exclude '/task'
    if ! git -C "$MAIN" worktree add -b "agent/$task" "$WT_DIR/$task" "$base" >/dev/null; then
      die "cannot create worktree (base '$base'?)"
    fi
    wt_path="$(canon_dir "$WT_DIR/$task")"
    created="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    task_file="$wt_path/task"
    printf 'task=%s\n' "$task" >"$task_file"
    printf 'branch=agent/%s\n' "$task" >>"$task_file"
    if [ -n "$agent" ]; then
      printf 'agent=%s\n' "$agent" >>"$task_file"
    fi
    if [ -n "$session" ]; then
      printf 'sessionID=%s\n' "$session" >>"$task_file"
    fi
    printf 'created=%s\n' "$created" >>"$task_file"
    printf '%s\n' "$wt_path"
    ;;

  merge)
    [ $# -le 2 ] || die "usage: agent-wt merge <task>"
    safe "$task"
    if ! git -C "$MAIN" show-ref --verify --quiet "refs/heads/agent/$task"; then
      die "branch agent/$task not found"
    fi
    wt="$(canon_dir "$WT_DIR/$task")"
    if [ ! -d "$wt" ]; then
      die "worktree not found: $wt"
    fi
    if [ -n "$(git -C "$wt" status --porcelain 2>/dev/null || true)" ]; then
      die "$task has uncommitted changes: commit them first in $wt"
    fi
    if git -C "$MAIN" merge --no-ff -m "merge agent/$task" "agent/$task"; then
      printf '✅ agent/%s merged\n' "$task"
    else
      printf '⚠️  CONFLICTS in agent/%s. Files:\n' "$task" >&2
      git -C "$MAIN" diff --name-only --diff-filter=U >&2 || true
      printf "Resolve them, then 'git add' + 'git commit' in %s (or 'git merge --abort').\n" "$MAIN" >&2
      exit 2
    fi
    ;;

  remove)
    [ $# -le 3 ] || die "usage: agent-wt remove <task> [--force]"
    safe "$task"
    force=0
    case "${3:-}" in
      --force) force=1 ;;
      "") ;;
      *) die "usage: agent-wt remove <task> [--force]" ;;
    esac
    wt="$(canon_dir "$WT_DIR/$task")"
    registered=0
    if git -C "$MAIN" worktree list --porcelain | grep -Fxq "worktree $wt"; then
      registered=1
    fi
    if [ "$registered" -eq 0 ]; then
      if ! git -C "$MAIN" show-ref --verify --quiet "refs/heads/agent/$task"; then
        die "worktree and branch not found for task $task"
      fi
      if git -C "$MAIN" branch -d "agent/$task" 2>/dev/null; then
        printf '✅ branch agent/%s deleted (worktree already gone)\n' "$task"
      else
        printf 'Branch agent/%s kept (not merged?)\n' "$task"
      fi
      exit 0
    fi
    if [ "$force" -eq 0 ] && [ -d "$wt" ] &&
      [ -n "$(git -C "$wt" status --porcelain 2>/dev/null || true)" ]; then
      die "$task has uncommitted changes in $wt: commit them, or rerun with --force to discard them."
    fi
    if [ -d "$wt" ]; then
      if [ "$force" -eq 1 ]; then
        git -C "$MAIN" worktree remove --force "$wt" || die "cannot remove: $wt"
      else
        git -C "$MAIN" worktree remove "$wt" || die "cannot remove: $wt (uncommitted changes?)"
      fi
    else
      # Worktree deleted by hand: clean the metadata before the branch.
      git -C "$MAIN" worktree prune
    fi
    if ! git -C "$MAIN" show-ref --verify --quiet "refs/heads/agent/$task"; then
      printf '✅ agent/%s worktree removed (branch already gone)\n' "$task"
    elif git -C "$MAIN" branch -d "agent/$task" 2>/dev/null; then
      printf '✅ agent/%s worktree and branch removed\n' "$task"
    else
      printf 'Branch agent/%s kept (not merged?)\n' "$task"
    fi
    ;;

  list)
    [ $# -le 2 ] || die "usage: agent-wt list [--porcelain]"
    case "${2:-}" in
      "") git -C "$MAIN" worktree list ;;
      --porcelain) worktree_records row_porcelain ;;
      *) die "usage: agent-wt list [--porcelain]" ;;
    esac
    ;;

  registry)
    [ $# -le 3 ] || die "usage: agent-wt registry [--out <file>]"
    out=""
    case "${2:-}" in
      "") ;;
      --out)
        [ $# -eq 3 ] || die "usage: agent-wt registry [--out <file>]"
        out="$3"
        ;;
      *) die "usage: agent-wt registry [--out <file>]" ;;
    esac
    tmp=""
    hist=""
    cleanup_registry() {
      if [ -n "$tmp" ]; then rm -f -- "$tmp"; fi
      if [ -n "$hist" ]; then rm -f -- "$hist"; fi
    }
    trap cleanup_registry EXIT
    tmp="$(mktemp "${TMPDIR:-/tmp}/agent-wt-registry.XXXXXX")"
    {
      printf '# Task registry\n\n'
      printf "> Snapshot generated on %s by \`agent-wt registry\`.\n" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
      printf '> Ahead/Behind: commits relative to the main repository HEAD.\n\n'
      printf '| Task | Branch | Dirty | Ahead/Behind | Commit | Path |\n'
      printf '| --- | --- | --- | --- | --- | --- |\n'
      worktree_records row_markdown
      printf '\n'
      printf "_Dirty: 0 clean, 1 uncommitted changes. \`task\` files without a worktree are ignored._\n"
    } >"$tmp"
    if [ -n "$out" ]; then
      # Keep the history section from a previous registry, including legacy French heading.
      if [ -f "$out" ] && grep -qE '^## (History|Historique)' "$out"; then
        hist="$(mktemp "${TMPDIR:-/tmp}/agent-wt-history.XXXXXX")"
        awk '/^## (History|Historique)/ { seen = 1 } seen { print }' "$out" >"$hist"
      fi
      cat -- "$tmp" >"$out"
      if [ -n "$hist" ]; then
        printf '\n' >>"$out"
        cat -- "$hist" >>"$out"
      fi
      printf '✅ registry written: %s\n' "$out" >&2
    else
      cat -- "$tmp"
    fi
    ;;

  integration)
    safe "$task"
    base="${3:-main}"
    if [ -n "$(git -C "$MAIN" status --porcelain)" ]; then
      die "Main repository is not clean: commit first."
    fi
    git -C "$MAIN" fetch -q origin "$base"
    git -C "$MAIN" switch -c "integration/$task" "origin/$base"
    printf '✅ branch integration/%s created from origin/%s\n' "$task" "$base"
    ;;

  sync)
    base="${2:-main}"
    git -C "$MAIN" fetch -q origin "$base"
    if git -C "$MAIN" rebase "origin/$base"; then
      printf '✅ rebased onto origin/%s\n' "$base"
    else
      printf '⚠️  CONFLICTS while rebasing onto origin/%s. Files:\n' "$base" >&2
      git -C "$MAIN" diff --name-only --diff-filter=U >&2 || true
      printf "Resolve them, 'git add', then 'git rebase --continue' in %s (or 'git rebase --abort').\n" "$MAIN" >&2
      exit 2
    fi
    ;;

  --help | -h | help)
    usage 0
    ;;

  *)
    usage
    ;;
esac
