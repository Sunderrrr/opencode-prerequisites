#!/usr/bin/env bash
# oc-deps: drift of the versions pinned by the kit.
#   oc-deps check
#   oc-deps check --only trivy --json
#   oc-deps update --write --yes
# See "oc-deps --help". "check" is read-only.
set -Eeuo pipefail

# GUI-launched OpenCode Desktop does not inherit the shell PATH (Electron): load the kit PATH.
# shellcheck disable=SC1091
for d in "${OPENCODE_CONFIG_DIR:-$HOME/.config/opencode}/libexec" "$HOME/.config/opencode/libexec" "$(cd "$(dirname "$0")/../libexec" 2>/dev/null && pwd)"; do [ -r "$d/desktop-env.sh" ] && . "$d/desktop-env.sh" && break; done

here="$(cd -- "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
config="${OPENCODE_CONFIG_DIR:-$HOME/.config/opencode}"

command -v node >/dev/null 2>&1 || {
  printf '❌ oc-deps: node not found in PATH\n' >&2
  exit 127
}

# From the repository: ../libexec/oc-deps.mjs; installed: <config>/libexec/oc-deps.mjs.
if [ -f "$here/../libexec/oc-deps.mjs" ]; then
  exec node "$here/../libexec/oc-deps.mjs" "$@"
fi
if [ -f "$config/libexec/oc-deps.mjs" ]; then
  exec node "$config/libexec/oc-deps.mjs" "$@"
fi

printf '❌ oc-deps: oc-deps.mjs not found (neither %s nor %s)\n' \
  "$here/../libexec" "$config/libexec" >&2
exit 127
