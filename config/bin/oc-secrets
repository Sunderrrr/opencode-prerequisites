#!/usr/bin/env bash
# oc-secrets: secret store for the kit with OS keyring and file backends.
#   oc-secrets set NAME        read the value from stdin, store it
#   oc-secrets get NAME        print the value
#   oc-secrets list            list names only
#   oc-secrets rm NAME         delete a secret
#   oc-secrets export          print export NAME='value' lines for eval
#   oc-secrets check           list names and warn about bad permissions
#   oc-secrets backend         show the active backend and why
#   oc-secrets migrate         move file secrets into the OS keyring
#
# Backend: OC_SECRETS_BACKEND=auto|file|keyring (default auto).
#   keyring: Linux secret-tool (libsecret), macOS security (Keychain),
#            Windows PowerShell DPAPI (%USERPROFILE%\.config\opencode\secrets).
#   file:    $OPENCODE_CONFIG_DIR/secrets (default ~/.config/opencode/secrets).
# The file backend is mode 700/600 but NOT encrypted at rest.
# The script is Bash-only (macOS ships Bash 3.2); it avoids Bash 4+ features.
set -Eeuo pipefail

# GUI-launched OpenCode Desktop does not inherit the shell PATH (Electron): load the kit PATH.
# shellcheck disable=SC1091
for d in "${OPENCODE_CONFIG_DIR:-$HOME/.config/opencode}/libexec" "$HOME/.config/opencode/libexec" "$(cd "${BASH_SOURCE[0]%/*}/../libexec" 2>/dev/null && pwd)"; do [ -r "$d/desktop-env.sh" ] && . "$d/desktop-env.sh" && break; done
umask 077

KEYRING_SERVICE="opencode-prerequisites"

config_dir="${OPENCODE_CONFIG_DIR:-$HOME/.config/opencode}"
secrets_dir="$config_dir/secrets"
requested_backend="${OC_SECRETS_BACKEND:-auto}"

tmp=""
os=""
keyring_ok=0
keyring_kind=""
keyring_reason=""
keyring_pwsh=""
backend=""
backend_reason=""

cleanup() {
  if [ -n "${tmp:-}" ] && [ -e "$tmp" ]; then
    rm -f "$tmp" || true
  fi
}
trap cleanup EXIT
trap 'printf "oc-secrets: unexpected failure at line %s (status %s)\n" "$LINENO" "$?" >&2' ERR

usage() {
  cat <<'EOF'
Usage: oc-secrets <command> [NAME]

Commands:
  set <NAME>    read the value from stdin and store it
  get <NAME>    print the value to stdout
  list          list secret names (never values)
  rm <NAME>     delete a secret
  export        print export NAME='value' lines for eval
  check         list names and check permissions (never values)
  backend       show the active backend and why
  migrate       move file secrets into the OS keyring (keeps a backup)
  --help        show this help

Backend: OC_SECRETS_BACKEND=auto|file|keyring (default auto)
  keyring  Linux secret-tool (libsecret), macOS Keychain, Windows DPAPI
  file     $OPENCODE_CONFIG_DIR/secrets
           (default ~/.config/opencode/secrets)

auto uses the OS keyring when its tool and session are available, otherwise
the file backend. The file backend is mode 700/600 but NOT encrypted at rest.

Names must match [A-Z0-9_]+.

Examples:
  oc-secrets set CONTEXT7_API_KEY
  oc-secrets backend
  oc-secrets migrate
  eval "$(oc-secrets export)" && opencode
EOF
}

usage_error() {
  printf 'oc-secrets: %s\n\n' "$*" >&2
  usage >&2
  exit 2
}

die() {
  printf 'oc-secrets: %s\n' "$*" >&2
  exit 1
}

valid_name() {
  case "$1" in
    "" | *[!A-Z0-9_]*) return 1 ;;
  esac
  return 0
}

require_name() {
  if [ "$#" -ne 1 ]; then
    usage_error "expected exactly one NAME"
  fi
  if ! valid_name "$1"; then
    usage_error "invalid secret name '$1' (allowed: A-Z, 0-9, _)"
  fi
}

require_backend() {
  if [ "$backend" = "unavailable" ]; then
    die "$backend_reason"
  fi
}

ensure_dir() {
  if [ -e "$secrets_dir" ] && [ ! -d "$secrets_dir" ]; then
    die "not a directory: $secrets_dir"
  fi
  mkdir -p "$secrets_dir"
  chmod 700 "$secrets_dir"
}

file_mode() {
  local path="$1" mode
  mode="$(stat -c '%a' "$path" 2>/dev/null || stat -f '%Lp' "$path" 2>/dev/null || printf '?')"
  printf '%s\n' "$mode"
}

read_value() {
  local name="$1" value=""
  if [ -t 0 ]; then
    printf 'Value for %s (hidden, then Enter): ' "$name" >&2
    IFS= read -r -s value || true
    printf '\n' >&2
  else
    value="$(cat)"
  fi
  printf '%s' "$value"
}

shell_quote() {
  local value="$1"
  value=${value//\'/\'\\\'\'}
  printf "'%s'" "$value"
}

detect_os() {
  local kernel
  kernel="$(uname -s 2>/dev/null || printf 'unknown')"
  case "$kernel" in
    Darwin) printf 'darwin' ;;
    Linux) printf 'linux' ;;
    MINGW* | MSYS* | CYGWIN*) printf 'windows' ;;
    *) printf 'unknown' ;;
  esac
}

detect_keyring() {
  case "$os" in
    linux)
      if ! command -v secret-tool >/dev/null 2>&1; then
        keyring_reason="secret-tool is not installed"
        return 1
      fi
      if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
        keyring_reason="DBUS_SESSION_BUS_ADDRESS is not set"
        return 1
      fi
      keyring_kind="linux secret-tool"
      keyring_reason="secret-tool is installed and DBUS_SESSION_BUS_ADDRESS is set"
      return 0
      ;;
    darwin)
      if ! command -v security >/dev/null 2>&1; then
        keyring_reason="the security command is not installed"
        return 1
      fi
      keyring_kind="macOS Keychain"
      keyring_reason="the security command is available"
      return 0
      ;;
    windows)
      if command -v powershell.exe >/dev/null 2>&1; then
        keyring_pwsh="powershell.exe"
      elif command -v powershell >/dev/null 2>&1; then
        keyring_pwsh="powershell"
      else
        keyring_reason="PowerShell is not installed"
        return 1
      fi
      keyring_kind="Windows DPAPI"
      keyring_reason="PowerShell is available ($keyring_pwsh)"
      return 0
      ;;
    *)
      keyring_reason="unsupported operating system"
      return 1
      ;;
  esac
}

resolve_backend() {
  os="$(detect_os)"
  keyring_ok=0
  keyring_kind=""
  keyring_reason=""
  keyring_pwsh=""
  case "$requested_backend" in
    auto | file | keyring) ;;
    *)
      printf "oc-secrets: invalid OC_SECRETS_BACKEND '%s' (allowed: auto, file, keyring)\n" "$requested_backend" >&2
      exit 2
      ;;
  esac
  if [ "$requested_backend" = "file" ]; then
    backend="file"
    backend_reason="forced by OC_SECRETS_BACKEND=file"
    return 0
  fi
  if detect_keyring; then
    keyring_ok=1
  fi
  if [ "$requested_backend" = "keyring" ]; then
    if [ "$keyring_ok" -eq 1 ]; then
      backend="keyring"
      backend_reason="forced by OC_SECRETS_BACKEND=keyring ($keyring_kind)"
    else
      backend="unavailable"
      backend_reason="OC_SECRETS_BACKEND=keyring but $keyring_reason"
    fi
    return 0
  fi
  if [ "$keyring_ok" -eq 1 ]; then
    backend="keyring"
    backend_reason="auto: $keyring_reason ($keyring_kind)"
  else
    backend="file"
    backend_reason="auto: $keyring_reason; using the file backend"
  fi
}

# --- file backend -----------------------------------------------------------

list_file_names() {
  local file name
  [ -d "$secrets_dir" ] || return 0
  for file in "$secrets_dir"/*; do
    [ -f "$file" ] || continue
    name="${file##*/}"
    valid_name "$name" || continue
    printf '%s\n' "$name"
  done
}

store_file() {
  local name="$1" value="$2" file
  ensure_dir
  file="$secrets_dir/$name"
  tmp="$(mktemp "$secrets_dir/.tmp.XXXXXX")"
  chmod 600 "$tmp"
  printf '%s' "$value" >"$tmp"
  mv -f "$tmp" "$file"
  tmp=""
  chmod 600 "$file"
  printf 'Stored %s in %s\n' "$name" "$file"
  printf 'oc-secrets: warning: the file backend is mode 600 but not encrypted at rest; protect backups.\n' >&2
}

# --- keyring backend --------------------------------------------------------

ps_path() {
  if command -v cygpath >/dev/null 2>&1; then
    cygpath -w "$1"
  else
    printf '%s' "$1"
  fi
}

dpapi_file() {
  printf '%s/%s.dpapi' "$secrets_dir" "$1"
}

dpapi_set() {
  local name="$1" value="$2" file tmpfile ps_file
  ensure_dir
  file="$(dpapi_file "$name")"
  tmpfile="$(mktemp "$secrets_dir/.tmp.XXXXXX")"
  tmp="$tmpfile"
  ps_file="$(ps_path "$tmpfile")"
  # shellcheck disable=SC2016
  if ! printf '%s' "$value" | OC_SECRETS_DPAPI_FILE="$ps_file" "$keyring_pwsh" -NoProfile -NonInteractive -Command '$ErrorActionPreference = "Stop"; $plain = [Console]::In.ReadToEnd(); $secure = ConvertTo-SecureString -String $plain -AsPlainText -Force; ConvertFrom-SecureString -SecureString $secure | Set-Content -LiteralPath $env:OC_SECRETS_DPAPI_FILE -NoNewline'; then
    rm -f "$tmpfile"
    tmp=""
    return 1
  fi
  mv -f "$tmpfile" "$file"
  tmp=""
  chmod 600 "$file" 2>/dev/null || true
}

dpapi_get() {
  local name="$1" file ps_file value errfile
  file="$(dpapi_file "$name")"
  [ -f "$file" ] || return 3
  ps_file="$(ps_path "$file")"
  errfile="$(mktemp "${TMPDIR:-/tmp}/oc-secrets.XXXXXX")" || return 1
  # shellcheck disable=SC2016
  if ! value="$(OC_SECRETS_DPAPI_FILE="$ps_file" "$keyring_pwsh" -NoProfile -NonInteractive -Command '$ErrorActionPreference = "Stop"; $secure = ConvertTo-SecureString (Get-Content -Raw -LiteralPath $env:OC_SECRETS_DPAPI_FILE); $cred = New-Object System.Net.NetworkCredential -ArgumentList "", $secure; [Console]::Out.Write($cred.Password)' 2>"$errfile")"; then
    cat "$errfile" >&2
    rm -f "$errfile"
    return 1
  fi
  rm -f "$errfile"
  printf '%s' "$value"
}

keyring_set() {
  local name="$1" value="$2"
  case "$os" in
    linux)
      printf '%s' "$value" | secret-tool store --label="opencode-prerequisites: $name" service "$KEYRING_SERVICE" username "$name"
      ;;
    darwin)
      security add-generic-password -U -s "$KEYRING_SERVICE" -a "$name" -w "$value"
      ;;
    windows)
      dpapi_set "$name" "$value"
      ;;
    *) return 1 ;;
  esac
}

keyring_get() {
  local name="$1" value status errfile
  case "$os" in
    linux)
      errfile="$(mktemp "${TMPDIR:-/tmp}/oc-secrets.XXXXXX")" || return 1
      if value="$(secret-tool lookup service "$KEYRING_SERVICE" username "$name" 2>"$errfile")"; then
        rm -f "$errfile"
        printf '%s' "$value"
        return 0
      else
        status=$?
      fi
      if [ -s "$errfile" ]; then
        cat "$errfile" >&2
        rm -f "$errfile"
        return 1
      fi
      rm -f "$errfile"
      return 3
      ;;
    darwin)
      errfile="$(mktemp "${TMPDIR:-/tmp}/oc-secrets.XXXXXX")" || return 1
      if value="$(security find-generic-password -s "$KEYRING_SERVICE" -a "$name" -w 2>"$errfile")"; then
        rm -f "$errfile"
        printf '%s' "$value"
        return 0
      else
        status=$?
      fi
      if [ "$status" -eq 44 ]; then
        rm -f "$errfile"
        return 3
      fi
      cat "$errfile" >&2
      rm -f "$errfile"
      return 1
      ;;
    windows)
      dpapi_get "$name"
      ;;
    *) return 1 ;;
  esac
}

keyring_rm() {
  local name="$1" file status
  case "$os" in
    linux)
      keyring_get "$name" >/dev/null || {
        status=$?
        if [ "$status" -eq 3 ]; then
          return 3
        fi
        return 1
      }
      secret-tool clear service "$KEYRING_SERVICE" username "$name" 2>/dev/null
      ;;
    darwin)
      security delete-generic-password -s "$KEYRING_SERVICE" -a "$name" >/dev/null 2>&1 || {
        status=$?
        if [ "$status" -eq 44 ]; then
          return 3
        fi
        return 1
      }
      ;;
    windows)
      file="$(dpapi_file "$name")"
      [ -f "$file" ] || return 3
      rm -f "$file"
      ;;
    *) return 1 ;;
  esac
}

keyring_list_names() {
  local out file name
  case "$os" in
    linux)
      # secret-tool prints the secret on stdout and the attributes on stderr;
      # keep stderr only, so list never reads a value.
      out="$(secret-tool search --all service "$KEYRING_SERVICE" 2>&1 >/dev/null || true)"
      [ -n "$out" ] || return 0
      printf '%s\n' "$out" | awk '/^attribute\.username = / { sub(/^attribute\.username = /, ""); print }'
      ;;
    darwin)
      out="$(security dump-keychain 2>/dev/null || true)"
      [ -n "$out" ] || return 0
      printf '%s\n' "$out" | awk -v service="$KEYRING_SERVICE" '
        /^[[:space:]]*"acct"<blob>=/ {
          line = $0
          sub(/^[^=]*=/, "", line)
          gsub(/^"|"$/, "", line)
          acct = line
          next
        }
        /^[[:space:]]*"svce"<blob>=/ {
          line = $0
          sub(/^[^=]*=/, "", line)
          gsub(/^"|"$/, "", line)
          svce = line
          next
        }
        /^class: / {
          if (svce == service && acct != "") print acct
          acct = ""
          svce = ""
        }
        END {
          if (svce == service && acct != "") print acct
        }
      '
      ;;
    windows)
      [ -d "$secrets_dir" ] || return 0
      for file in "$secrets_dir"/*.dpapi; do
        [ -f "$file" ] || continue
        name="${file##*/}"
        name="${name%.dpapi}"
        printf '%s\n' "$name"
      done
      ;;
    *) return 1 ;;
  esac
}

# --- backend-agnostic helpers ----------------------------------------------

list_names() {
  local names name
  case "$backend" in
    file) names="$(list_file_names)" ;;
    keyring) names="$(keyring_list_names)" ;;
    *) return 1 ;;
  esac
  while IFS= read -r name; do
    [ -n "$name" ] || continue
    valid_name "$name" || continue
    printf '%s\n' "$name"
  done <<<"$names" | LC_ALL=C sort -u
}

get_value() {
  local name="$1" file
  case "$backend" in
    file)
      file="$secrets_dir/$name"
      [ -f "$file" ] || return 3
      printf '%s' "$(<"$file")"
      ;;
    keyring)
      keyring_get "$name"
      ;;
    *) return 1 ;;
  esac
}

delete_value() {
  local name="$1" file
  case "$backend" in
    file)
      file="$secrets_dir/$name"
      [ -f "$file" ] || return 3
      rm -f "$file"
      ;;
    keyring)
      keyring_rm "$name"
      ;;
    *) return 1 ;;
  esac
}

# --- commands ---------------------------------------------------------------

cmd_set() {
  local name value
  require_name "$@"
  require_backend
  name="$1"
  value="$(read_value "$name")"
  if [ -z "$value" ]; then
    die "empty value for $name (pipe the secret on stdin)"
  fi
  case "$backend" in
    file)
      store_file "$name" "$value"
      ;;
    keyring)
      keyring_set "$name" "$value" || die "could not store $name in the OS keyring"
      printf 'Stored %s in the OS keyring (%s)\n' "$name" "$keyring_kind"
      ;;
  esac
}

cmd_get() {
  local value status
  require_name "$@"
  require_backend
  value="$(get_value "$1")" || {
    status=$?
    if [ "$status" -eq 3 ]; then
      die "no such secret: $1"
    fi
    die "could not read secret: $1"
  }
  printf '%s\n' "$value"
}

cmd_list() {
  [ "$#" -eq 0 ] || usage_error "list takes no argument"
  require_backend
  list_names
}

cmd_rm() {
  local status
  require_name "$@"
  require_backend
  delete_value "$1" || {
    status=$?
    if [ "$status" -eq 3 ]; then
      die "no such secret: $1"
    fi
    die "could not remove secret: $1"
  }
  printf 'Removed %s\n' "$1"
}

cmd_export() {
  local names name value
  [ "$#" -eq 0 ] || usage_error "export takes no argument"
  require_backend
  names="$(list_names)"
  while IFS= read -r name; do
    [ -n "$name" ] || continue
    if value="$(get_value "$name")"; then
      printf 'export %s=%s\n' "$name" "$(shell_quote "$value")"
    else
      printf 'oc-secrets: warning: cannot read %s; skipped\n' "$name" >&2
    fi
  done <<<"$names"
}

cmd_check() {
  local file name mode bad=0
  [ "$#" -eq 0 ] || usage_error "check takes no argument"
  require_backend
  if [ "$backend" = "keyring" ]; then
    list_names
    return 0
  fi
  [ -d "$secrets_dir" ] || return 0
  mode="$(file_mode "$secrets_dir")"
  if [ "$mode" != "700" ]; then
    printf 'oc-secrets: warning: %s has mode %s (expected 700)\n' "$secrets_dir" "$mode" >&2
    bad=1
  fi
  for file in "$secrets_dir"/*; do
    [ -f "$file" ] || continue
    name="${file##*/}"
    valid_name "$name" || continue
    mode="$(file_mode "$file")"
    if [ "$mode" != "600" ]; then
      printf 'oc-secrets: warning: %s has mode %s (expected 600)\n' "$file" "$mode" >&2
      bad=1
    fi
  done
  list_names
  if [ "$bad" -ne 0 ]; then
    exit 1
  fi
}

cmd_backend() {
  [ "$#" -eq 0 ] || usage_error "backend takes no argument"
  printf 'Backend: %s\n' "$backend"
  printf 'Requested: %s\n' "$requested_backend"
  printf 'Reason: %s\n' "$backend_reason"
  if [ "$backend" = "unavailable" ]; then
    exit 1
  fi
}

cmd_migrate() {
  local names name value backup stored migrated=0 failed=0
  [ "$#" -eq 0 ] || usage_error "migrate takes no argument"
  require_backend
  if [ "$backend" != "keyring" ]; then
    die "migrate needs the keyring backend; $backend_reason"
  fi
  names="$(list_file_names)"
  if [ -z "$names" ]; then
    printf 'Nothing to migrate: no file secrets in %s\n' "$secrets_dir"
    return 0
  fi
  command -v tar >/dev/null 2>&1 || die "migrate needs tar to write the backup"
  mkdir -p "$config_dir"
  backup="$config_dir/secrets-backup-$(date -u +%Y%m%dT%H%M%S).tar"
  if [ -e "$backup" ]; then
    backup="$config_dir/secrets-backup-$(date -u +%Y%m%dT%H%M%S)-$$.tar"
  fi
  tar -cf "$backup" -C "$secrets_dir" .
  chmod 600 "$backup" 2>/dev/null || true
  printf 'oc-secrets: backup written to %s (plaintext; delete it after verifying)\n' "$backup" >&2
  while IFS= read -r name; do
    [ -n "$name" ] || continue
    value="$(<"$secrets_dir/$name")"
    if keyring_set "$name" "$value" && stored="$(keyring_get "$name")" && [ "$stored" = "$value" ]; then
      rm -f "$secrets_dir/$name"
      migrated=$((migrated + 1))
      printf 'Migrated %s\n' "$name"
    else
      failed=$((failed + 1))
      printf 'oc-secrets: failed to migrate %s; the file was kept\n' "$name" >&2
    fi
  done <<<"$names"
  printf 'Migrated %s secret(s), %s failed\n' "$migrated" "$failed"
  printf 'Backup: %s\n' "$backup"
  if [ "$failed" -ne 0 ]; then
    exit 1
  fi
}

# --- dispatch ---------------------------------------------------------------

command="${1:-}"
if [ "$#" -gt 0 ]; then
  shift
fi

case "$command" in
  help | -h | --help)
    usage
    exit 0
    ;;
  "")
    usage_error "missing command"
    ;;
  set | get | list | rm | export | check | backend | migrate) ;;
  *)
    usage_error "unknown command: $command"
    ;;
esac

resolve_backend

case "$command" in
  set) cmd_set "$@" ;;
  get) cmd_get "$@" ;;
  list) cmd_list "$@" ;;
  rm) cmd_rm "$@" ;;
  export) cmd_export "$@" ;;
  check) cmd_check "$@" ;;
  backend) cmd_backend "$@" ;;
  migrate) cmd_migrate "$@" ;;
esac
