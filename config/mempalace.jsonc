{
  // Settings for the opencode-mempalace plugin (read from ~/.config/opencode/mempalace.jsonc).
  // Warning: inline // comments break the plugin's JSON.parse (it only strips comments at the start of a line).
  "autosaveEnabled": true,
  "retrievalEnabled": true,
  "keywordSaveEnabled": true,
  // Limits the injected context (saves Go quota).
  "maxInjectedItems": 6,
  "retrievalQueryLimit": 5,
  // Masks secrets before saving.
  "privacyRedactionEnabled": true,
  // Triggers autosave on these words (regex \b...\b, case-insensitive, so the French variants match too).
  // The list REPLACES the plugin's default patterns: the English ones are kept for that reason.
  "keywordPatterns": [
    "remember",
    "save this",
    "don't forget",
    "note that",
    "retiens",
    "retiens ça",
    "souviens-toi",
    "note que",
    "n'oublie pas"
  ]
}
