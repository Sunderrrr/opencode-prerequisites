# Variables optionnelles (à exporter dans ton shell ; ne commite jamais un vrai .env)
CONTEXT7_API_KEY=            # clé gratuite sur https://context7.com (MCP context7)
OBSCURA_BIN_DIR=             # dossier des binaires (défaut : ~/.local/bin)
OPENCODE_CONFIG_DIR=         # dossier de config (défaut : ~/.config/opencode)
MEMPALACE_ADAPTER_PYTHON=    # python où mempalace est installé (si venv)
