# Optional variables (export them in your shell; never commit a real .env)
CONTEXT7_API_KEY=            # free key at https://context7.com (context7 MCP)
OBSCURA_BIN_DIR=             # binary directory (default: ~/.local/bin)
OPENCODE_CONFIG_DIR=         # config directory (default: ~/.config/opencode)
MEMPALACE_ADAPTER_PYTHON=    # python where mempalace is installed (if venv)
